# ==============================================================================
# SmartTraffic Bandar Lampung - Konfigurasi Lingkungan
# ==============================================================================

# Port aplikasi berjalan (default: 3000)
PORT=3000

# URL Koneksi PostgreSQL
# Format: postgres://username:password@host:port/database_name
# Contoh lokal: postgres://postgres:postgres@localhost:5432/smarttraffic_bdl
# Contoh cloud (Neon/Supabase): postgres://user:pass@ep-cool-fog-123456.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgres://postgres:postgres@localhost:5432/smarttraffic_bdl

# Rahasia JWT (Minimal 32 karakter untuk HS256)
JWT_SECRET=rahasia-kunci-super-aman-smarttraffic-bandar-lampung-2026-teknokrat-dishub

# Durasi masa aktif token sesi JWT dalam detik (86400 = 24 jam)
JWT_EXPIRATION_SECONDS=86400

# Level Logging Rust (trace, debug, info, warn, error)
RUST_LOG=smarttraffic=info,tower_http=info

# Mode Demo / Standalone (true/false)
# Jika true dan DATABASE_URL tidak dapat diakses, sistem menggunakan in-memory state dengan data seed Bandar Lampung
STANDALONE_DEMO=true

